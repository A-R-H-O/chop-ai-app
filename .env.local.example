# Copy to .env.local and fill in. `npx supabase start` prints the local
# Supabase values; the PostHog and Sentry keys come from their dashboards.
# Both analytics wrappers no-op on a missing key, so the app runs without them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

SENTRY_DSN=

# LemonSqueezy (plan 2 task 8)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_100=
LEMONSQUEEZY_VARIANT_300=
LEMONSQUEEZY_VARIANT_1000=

# Modal worker. The endpoint is printed by `modal deploy worker/chop_app.py`.
# WORKER_SHARED_SECRET must match the value in the Modal secret named
# "chop-ai", which also carries SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# ANTHROPIC_API_KEY and YTDLP_PROXY_URL.
MODAL_ENDPOINT_URL=
WORKER_SHARED_SECRET=
