# Copy to .env.local and fill in. `npx supabase start` prints the local
# Supabase values; the PostHog and Sentry keys come from their dashboards.
# Both analytics wrappers no-op on a missing key, so the app runs without them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

SENTRY_DSN=
