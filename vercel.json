{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 4 * * *"
    }
  ],
  "functions": {
    "app/api/cron/retention/route.ts": {
      "maxDuration": 300
    }
  }
}
